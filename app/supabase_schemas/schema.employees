create table public.employees (
  staff_code text not null,
  full_name text not null,
  designation text not null default 'Operator'::text,
  department text not null default 'Operations'::text,
  cost_center text not null default 'CC-LOCAL'::text,
  created_at timestamp without time zone not null default CURRENT_TIMESTAMP,
  updated_at timestamp without time zone not null,
  constraint employees_pkey primary key (staff_code)
) TABLESPACE pg_default;

create index IF not exists employees_full_name_idx on public.employees using btree (full_name) TABLESPACE pg_default;